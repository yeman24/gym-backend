{
  "name": "ironhouse-gym-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.js",
    "start": "node scripts/migrate.js && node prisma/seed.js && node src/server.js",
    "build": "node scripts/generate-client.js && node scripts/migrate.js && node prisma/seed.js",
    "postinstall": "node scripts/generate-client.js",
    "prisma:generate": "node scripts/generate-client.js",
    "prisma:migrate": "node scripts/migrate.js",
    "prisma:seed": "node prisma/seed.js",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@google/genai": "^1.16.0",
    "@prisma/adapter-better-sqlite3": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "esbuild": "^0.25.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^7.0.0",
    "tsx": "^4.19.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "eslint": "^9.35.0",
    "nodemon": "^3.1.10"
  }
}
